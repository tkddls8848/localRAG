# 이 파일을 .env 로 복사해 채운다. 비밀값은 저장소에 넣지 않는다.
# 모든 값은 app/config.py 에서만 읽으며, 기동 시 한 번 검증한다.

# --- 실행 환경 ---
APP_ENV=local              # local | poc | prod
LOG_LEVEL=INFO
LOG_FORMAT=text            # json 이면 로그 수집기에 그대로 넣을 수 있다

# --- 저장소 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=specrag
POSTGRES_USER=specrag
POSTGRES_PASSWORD=change-me
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=8
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# --- 모델 런타임 ---
# 교체 지점: 다른 제공자를 쓰려면 PROVIDER 값만 바꾼다
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_CONTEXT_SIZE=8192
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m      # 짧으면 질문마다 모델 로딩 시간이 붙는다
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# 모델 런타임은 PoC 에서 가장 자주 넘어진다. 재시도와 차단기로 버틴다.
MODEL_RETRIES=3
MODEL_RETRY_BACKOFF_S=1.0
MODEL_TIMEOUT_S=180
MODEL_GENERATE_TIMEOUT_S=300
MODEL_BREAKER_THRESHOLD=5
MODEL_BREAKER_COOLDOWN_S=30

# --- 색인 ---
# 산문 청크 목표 크기(문자). 표는 행 단위라 이 값과 무관하다.
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
EMBED_BATCH_SIZE=16
DOC_ROOT=data/pdfs         # POST /admin/sync 가 동기화할 서버 디렉터리
INGEST_WORKERS=2
MAX_UPLOAD_MB=100
MIN_CHARS_PER_PAGE=120     # 이보다 적으면 스캔 PDF 로 의심하고 문서에 표시한다

# --- 검색 ---
SEARCH_TOP_K=10            # LLM 에 넘길 청크 수
SEARCH_CANDIDATES=50       # 각 검색 경로가 뽑는 후보 수 (RRF 결합 전)
RRF_K=60
WEIGHT_DENSE=1.0           # 경로 가중치. 바꿀 근거는 평가 결과여야 한다
WEIGHT_SPARSE=1.0
WEIGHT_TRIGRAM=0.6
HNSW_EF_SEARCH=100
SEARCH_NEIGHBOR_WINDOW=1   # 표 행 청크에 앞뒤 행을 함께 붙인다
# 결과 다양화: 근접 중복과 "한 표의 상위 독점"만 막는다. 관련도 순서는 흔들지 않는다.
NEAR_DUP_SIMILARITY=0.9    # 1.0 이면 근접 중복 정리를 끈다
SEARCH_SECTION_CAP=3       # 같은 섹션(대개 같은 표)에서 상위에 올릴 최대 건수. 0 이면 끈다
QUERY_EXPANSION=true       # 한국어 질문을 영문 문서 용어로 확장(용어집)
GLOSSARY_PATH=app/retrieval/glossary.yaml

# --- 리랭킹 ---
RERANK_PROVIDER=rules      # none | rules | llm
RERANK_CANDIDATES=30

# --- 답변 신뢰성 ---
# off: 검사 없음 / warn: 근거 없는 수치를 응답에 표시 / strict: 답변 보류
GROUNDING_MODE=warn

# --- 접근 제어 ---
# "키:역할:그룹1|그룹2" 를 쉼표로 나열. 비우면 인증이 꺼진다(로컬 전용).
# 역할: reader(질문) < editor(색인·삭제) < admin(동기화·로그 열람)
# 예) API_KEYS=9f2c8b1a4e7d6c5f:admin,3a7b2c9d8e1f4a6b:reader:sales
API_KEYS=
RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=              # 쉼표 구분. 비우면 CORS 를 켜지 않는다

# --- 운영 ---
QUERY_LOG_ENABLED=true     # 실패한 질문을 모으는 것이 품질 개선의 가장 빠른 길
METRICS_ENABLED=true       # GET /metrics (Prometheus 텍스트 형식)
