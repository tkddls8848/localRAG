# --- 저장소 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=specrag
POSTGRES_USER=specrag
POSTGRES_PASSWORD=change-me

# --- 모델 런타임 ---
# 교체 지점: 다른 제공자를 쓰려면 PROVIDER 값만 바꾼다
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_CONTEXT_SIZE=8192
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- 색인 ---
# 산문 청크 목표 크기(문자). 표는 행 단위라 이 값과 무관하다.
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
EMBED_BATCH_SIZE=16

# --- 검색 ---
SEARCH_TOP_K=10          # LLM 에 넘길 청크 수
SEARCH_CANDIDATES=50     # 각 검색 경로가 뽑는 후보 수 (RRF 결합 전)
